# ---- CardioLens AI backend (all variables prefixed CARDIOLENS_) ----
CARDIOLENS_ENV=development                      # development | test | production
CARDIOLENS_DATABASE_URL=sqlite:///./cardiolens.db
# Production: postgresql+psycopg://user:pass@host:5432/cardiolens
CARDIOLENS_JWT_SECRET=change-me-to-a-random-64-char-string   # REQUIRED in production (>=32 chars)
CARDIOLENS_JWT_TTL_MINUTES=60
CARDIOLENS_STORAGE_KEY=                         # REQUIRED in production: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CARDIOLENS_STORAGE_DIR=./data/recordings
# Object storage backend: local | s3 (audio is always encrypted client-side; S3 adds SSE-KMS)
CARDIOLENS_STORAGE_BACKEND=local
CARDIOLENS_S3_BUCKET=
CARDIOLENS_S3_PREFIX=recordings/
CARDIOLENS_S3_REGION=
CARDIOLENS_S3_ENDPOINT_URL=                     # only for S3-compatible stores (MinIO)
CARDIOLENS_S3_KMS_KEY_ID=                       # recommended: KMS key for SSE-KMS
# Schema management: create (dev) | migrate (production; run `alembic upgrade head`)
CARDIOLENS_SCHEMA_MODE=create
# Sign-in: local | oidc
CARDIOLENS_AUTH_MODE=local
CARDIOLENS_LOGIN_MAX_FAILURES=5                 # local mode lockout
CARDIOLENS_LOGIN_LOCKOUT_MINUTES=15
CARDIOLENS_OIDC_ISSUER=                         # e.g. https://login.microsoftonline.com/<tenant>/v2.0
CARDIOLENS_OIDC_AUDIENCE=                       # API audience in access tokens
CARDIOLENS_OIDC_CLIENT_ID=                      # public SPA client (PKCE, no secret)
CARDIOLENS_OIDC_SCOPES=openid profile email
CARDIOLENS_OIDC_ROLE_CLAIM=roles                # nested paths ok, e.g. realm_access.roles
CARDIOLENS_OIDC_ROLE_MAP=clinician:clinician,researcher:researcher,admin:admin
CARDIOLENS_OIDC_REQUIRE_MFA=true
CARDIOLENS_OIDC_AUTO_PROVISION=false
CARDIOLENS_OIDC_DEFAULT_ORG=
CARDIOLENS_MAX_UPLOAD_MB=20
CARDIOLENS_CORS_ORIGINS=http://localhost:5173
CARDIOLENS_SEED_DEMO_DATA=true                  # must be false in production
# Model inference: none (research-demo) | http (external model service) | local_baseline (research baseline weights)
CARDIOLENS_MODEL_BACKEND=none
CARDIOLENS_MODEL_SERVICE_URL=
CARDIOLENS_MODEL_CARD_PATH=                     # model card JSON (http) or weights.json (local_baseline)
CARDIOLENS_MODEL_SERVICE_TIMEOUT_S=10

# ---- Frontend (build-time, Vite) ----
# VITE_API_BASE=/api/v1
# VITE_SHOW_DEMO_ACCOUNTS=false
