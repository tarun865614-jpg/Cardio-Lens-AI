# ---- CardioLens AI backend (all variables prefixed CARDIOLENS_) ----
CARDIOLENS_ENV=development                      # development | test | production
CARDIOLENS_DATABASE_URL=sqlite:///./cardiolens.db
# Production: postgresql+psycopg://user:pass@host:5432/cardiolens
CARDIOLENS_JWT_SECRET=change-me-to-a-random-64-char-string   # REQUIRED in production (>=32 chars)
CARDIOLENS_JWT_TTL_MINUTES=60
CARDIOLENS_STORAGE_KEY=                         # REQUIRED in production: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CARDIOLENS_STORAGE_DIR=./data/recordings
CARDIOLENS_MAX_UPLOAD_MB=20
CARDIOLENS_CORS_ORIGINS=http://localhost:5173
CARDIOLENS_SEED_DEMO_DATA=true                  # must be false in production
# Model inference: none (research-demo) | http (external model service) | local_baseline (research baseline weights)
CARDIOLENS_MODEL_BACKEND=none
CARDIOLENS_MODEL_SERVICE_URL=
CARDIOLENS_MODEL_CARD_PATH=                     # model card JSON (http) or weights.json (local_baseline)
CARDIOLENS_MODEL_SERVICE_TIMEOUT_S=10

# ---- Frontend (build-time, Vite) ----
# VITE_API_BASE=/api/v1
# VITE_SHOW_DEMO_ACCOUNTS=false
